{
  "name": "@satoricorp/lgtm",
  "version": "0.2.0",
  "description": "lgtm MCP server (stdio): lgtm_review context from the local lgtm CLI.",
  "license": "AGPL-3.0-only",
  "homepage": "https://lgtm.cx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satoricorp/lgtm.git",
    "directory": "mcp"
  },
  "bin": {
    "lgtm-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/*.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "xmcp dev",
    "build": "xmcp build && bun run build:binary",
    "build:xmcp": "xmcp build",
    "build:binary": "bun build src/stdio.ts --compile --outfile dist/lgtm-mcp",
    "start": "./dist/lgtm-mcp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:xmcp && bun test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "xmcp": "0.6.10",
    "zod": "4.4.3"
  }
}
