{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.local/bin/tl\" capture transcript",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.local/bin/tl\" capture transcript",
            "type": "command"
          }
        ]
      }
    ]
  }
}
