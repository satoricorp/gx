# Copy to .env and fill in public client/build values. Used by `just build`,
# `just build-release`, `just install`, and release packaging. Runtime env still
# overrides baked values.

# Public GitHub OAuth client ID for `tx auth login`.
GITHUB_CLIENT_ID=

# Public auth and API origins. These are URLs only, not secrets.
CONVEX_SITE_URL=
TOTALITY_CLOUD_URL=

# Optional local cloud API key for MCP/review calls. Prefer `tx auth login` for
# normal use; do not commit real API keys.
TOTALITY_API_KEY=

# PostHog analytics. Use totality-staging locally; production key is baked into
# release builds via GitHub Actions vars (same token as console production).
TOTALITY_POSTHOG_KEY=
TOTALITY_POSTHOG_HOST=https://f.totality.sh

VERSION=dev
