# Copy to .env and fill in public client/build values. Used by `just build`,
# `just build-release`, `just install`, and release packaging. Runtime env still
# overrides baked values.

# Public GitHub OAuth client ID for `gx auth login`.
GITHUB_CLIENT_ID=

# Public auth and API origins. These are URLs only, not secrets.
CONVEX_SITE_URL=
GX_CLOUD_URL=

# Optional local cloud API key for MCP/review calls. Prefer `gx auth login` for
# normal use; do not commit real API keys.
GX_API_KEY=

# PostHog analytics. Use gx-staging locally; production key is baked into
# release builds via GitHub Actions vars (same token as console production).
GX_POSTHOG_KEY=
GX_POSTHOG_HOST=https://f.gx.run

VERSION=dev
