# Copy to .env for build values. Used by `just build`, `just build-release`,
# `just install`, and release packaging. Runtime env still overrides baked values.
#
# The gx Cloud endpoints below are optional and all-or-nothing: leave all three
# empty for a local build, which is the default and needs no server. Set all
# three only to build against a gx Cloud server of your own; `just verify-bake`
# refuses a binary with some of them missing. `just` also reads a .env in any
# parent directory, so a worktree inherits its main checkout's values.

# Public GitHub OAuth client ID for `gx auth login`.
GITHUB_CLIENT_ID=

# Public auth and API origins. These are URLs only, not secrets.
CONVEX_SITE_URL=
GX_CLOUD_URL=

# Optional API key for a gx Cloud server's MCP/review calls; do not commit real
# keys.
GX_API_KEY=

VERSION=dev
